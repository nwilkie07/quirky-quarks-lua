local players = {}

local board = nil


function onLoad()
  params = {
    click_function = "start_game",
    function_owner = self,
    position = {0, 1, 0},
    rotation = {0, 180, 0},
    width = 1200,
    height = 1500,
    color = {0.5, 0.5, 0.5, 0},
    tooltip = "Start the game.",
  }
  self.createButton(params)
  self.interactable = false
  players = Global.call("getPlayers")
  board = Global.getVar("collider_board")
end

function onPlayerChangeColor(player_color)
  players = Global.call("getPlayers")
end

function start_game()
  local starting_card = getObjectFromGUID("de36d4")
  local turn_control = getObjectFromGUID("90061a")

  if #players <= 1 then
    broadcastToAll("Not enough seated players!")
    return
  end

  Turns.enable = false
  turn_control.call("initiate_turns")
  local first_player = turn_control.call("get_current_turn")

  Global.setVar("starting_physicist", first_player)

  local starting_card_positions = Global.getTable("starting_card_positions")
  starting_card.setPositionSmooth(starting_card_positions[first_player])

  local particles = Global.getVar("particles_deck")
  local round_die = Global.getVar("round_die")
  local phase_die = Global.getVar("phase_die")
  local pos = Global.getVar("collider_board").getPosition()

  round_die.setPosition({pos[1] - 3.02, pos[2] + 1, pos[3] - 5.28})
  phase_die.setPosition({pos[1] - 3.02, pos[2] + 1, pos[3] + 2.91})
  UI.setAttribute("round_tracker", "text", "Round 1: Funding Phase")

  Global.setVar("neutrinosEndRound", true)
  initial_setup(particles)


  if #players == 2 then
    -- Wait for initial cards to be dealt before placing coins
    Wait.condition(
      function()
        deal_coins(particles, True)
        -- Wait for coins to settle before dealing collider cards
        Wait.condition(
          function()
            board.call("two_player_deal")
          end,
          function()
            -- Check that coins have settled
            return allCoinsResting()
          end,
          15, function() log("WARNING: Timeout waiting for coins to rest"); board.call("two_player_deal") end
        )
      end,
      function() return particles ~= nil and particles.resting end,
      15, function() log("WARNING: Timeout waiting for particle deck to rest"); deal_coins(particles, True) end
    )
  end

  if (#players == 3) or (#players == 4) then
    -- Wait for initial cards to be dealt before dealing collider cards
    Wait.condition(
      function()
        board.call("four_player_deal")
        -- Wait for collider dealing to start, then deal coins
        Wait.condition(
          function()
            deal_coins(particles, false)
          end,
          function() return particles ~= nil and particles.resting end,
          15, function() log("WARNING: Timeout waiting for particle deck"); deal_coins(particles, false) end
        )
      end,
      function() return particles ~= nil and particles.resting end,
      15, function() log("WARNING: Timeout waiting for particles deck to rest"); board.call("four_player_deal") end
    )
  end
end

function initial_setup(particles)
  -- deal out cards and quest to people
  particles.shuffle()
  particles.deal(3)
  local quest_one = Global.getVar("quest1_deck")
  quest_one.shuffle()
  quest_one.deal(1)

  --shuffling quest 2 deck
  local quest_two = Global.getVar("quest2_deck")
  quest_two.shuffle()

  -- resolve Neutrinos after cards have settled in hands
  Wait.condition(
    function()
      Global.call("checkForNeutrinos")
    end,
    function()
      -- Wait until both decks are resting after dealing
      return particles.resting and quest_one.resting
    end,
    15,
    function()
      log("WARNING: Timeout waiting for initial deal to complete, checking neutrinos anyway")
      Global.call("checkForNeutrinos")
    end
  )
end

-- Helper: checks if all coin objects in all player zones are resting
function allCoinsResting()
  local coin_zone_guids = Global.getTable("coin_zone_guids")
  for _, guid in pairs(coin_zone_guids) do
    local zone = getObjectFromGUID(guid)
    if zone then
      local objects = zone.getObjects()
      for _, obj in ipairs(objects) do
        if obj and not obj.resting then
          return false
        end
      end
    end
  end
  return true
end

function deal_coins(particles, isTwoPlayer)
  local one_ev = Global.getVar("one_ev_bag")
  local three_ev = Global.getVar("three_ev_bag")

  --places starting money in coin areas
  local coin_guids = Global.getTable("coin_board_guids")
  players = getSeatedPlayers()
  for i = 1, #players do
    local coin_area = getObjectFromGUID(coin_guids[players[i]])
    pos = coin_area.getPosition()
    local x_mod = 1.5
    local y = pos["y"] + 1
    local z_mod = pos["z"] + 1.5

    if players[i] == "Blue" or players[i] == "Green" then
      z_mod = pos["z"] - 1.5
    end

    one_ev.takeObject({
      position = {pos["x"] - x_mod, y, pos["z"]}
    })
    one_ev.takeObject({
      position = {pos["x"], y, pos["z"]}
    })
    if isTwoPlayer ~= True then
      one_ev.takeObject({
        position = {pos["x"] + x_mod, y, pos["z"]}
      })
      three_ev.takeObject({
        position = {pos["x"] + x_mod, y, z_mod}
      })
    end
    three_ev.takeObject({
      position = {pos["x"] - x_mod, y, z_mod}
    })
    three_ev.takeObject({
      position = {pos["x"], y, z_mod}
    })

    -- Destroy start button once all coins have settled
    Wait.condition(
      function()
        self.destruct()
      end,
      function() return allCoinsResting() end,
      20,
      function()
        log("WARNING: Timeout waiting for coins, destroying start button anyway")
        self.destruct()
      end
    )

  end
end