<!-- Xml UI. See documentation: https://api.tabletopsimulator.com/ui/introUI/ -->
<!-- Automatically adjust sizing based on Toggles Visible -->
<!--ADD CANCEL BUTTON-->

<Panel offsetXY="0 0">
  <Panel Width="200" Height="37" rectAlignment="upperCenter" allowDragging="true" returnToOriginalPositionWhenReleased="false">
    <Button id="change_turn" onClick="90061a/next_turn" tooltipPosition="Below" tooltip="Click to end your turn." color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000" visibility="" active="false">End Your Turn</Button>
    <Button id="turn_indicator" tooltipPosition="Below" color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000" visibility="" active="false">Players Turn</Button>
  </Panel>
</Panel>

<Panel offsetXY="80 0">
  <VerticalLayout spacing="5" rectAlignment="upperLeft" Width="200" Height="128" allowDragging="true" returnToOriginalPositionWhenReleased="false" childForceExpandHeight="false" childControlHeight="false">
    <Panel Width="200" Height="32">
      <Button id="toggle_tools" onClick="toggleUiTools" tooltipPosition="Right" tooltip="Sort the cards in your hand." color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000" visibility="">Show/Hide Tools</Button>
    </Panel>
    <Panel id="sort_cards_panel" Width="200" Height="32" visibility="Red|Blue|Green|Yellow" ignoreMouseOver="true">
      <Button id="sort_cards" onClick="sort_hand" tooltipPosition="Right" tooltip="Sort the cards in your hand." color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000" ignoreMouseOver="true">Sort Cards</Button>
    </Panel>
    <Panel id="sort_coins_panel" Width="200" Height="32" visibility="Red|Blue|Green|Yellow" ignoreMouseOver="true">
      <Button id="sort_coins" onClick="layout_coins" tooltipPosition="Right" tooltip="Sort the money in your coin area." color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000" ignoreMouseOver="true">Sort Coins</Button>
    </Panel>
    <Panel id="convert_coins_panel" Width="200" Height="32" visibility="Red|Blue|Green|Yellow" ignoreMouseOver="true">
      <Button id="convert_coins" onClick="convert_coins" tooltipPosition="Right" tooltip="If you have to many 1 eV coins." color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000" ignoreMouseOver="true">Convert Coins</Button>
    </Panel>
    <Panel id="update_ev_and_score_panel" Width="200" Height="32" visibility="Red|Blue|Green|Yellow" ignoreMouseOver="true">
      <Button id="update_score" onClick="updateScoreUi" tooltipPosition="Right" tooltip="Update coin and build area values in case of error." color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000" ignoreMouseOver="true">Update eV/Score</Button>
    </Panel>
  </VerticalLayout>
</Panel>

<Panel id="build_selector" rectAlignment="middleCenter" Width="150" Height="300" background="#FFFFFF">
  <TableLayout cellBackgroundColor="#FFFFFF" rowBackgroundColor="#FFFFFF" autoCalculateHeight="true">
    <Row id="row0" active="false" preferredHeight="50">
      <Cell>
        <Text id="indicator_text" color="#323232">Select</Text>
      </Cell>
    </Row>
    <Row id="row1" preferredHeight="50" active="false">
      <Cell>
        <Text id="text1">Option 1</Text>
        <Toggle id="toggle1" isOn="false" onValueChanged="toggleOption"></Toggle>
      </Cell>
    </Row>
    <Row id="row2" preferredHeight="50" active="false">
      <Cell>
        <Text id="text2">Option 2</Text>
        <Toggle id="toggle2" isOn="false" onValueChanged="toggleOption"></Toggle>
      </Cell>
    </Row>
    <Row id="row3" preferredHeight="50" active="false">
      <Cell>
        <Text id="text3">Option 3</Text>
        <Toggle id="toggle3" isOn="false" onValueChanged="toggleOption"></Toggle>
      </Cell>
    </Row>
    <Row id="row4" preferredHeight="50" active="false">
      <Cell>
        <Text id="text4">Option 4</Text>
        <Toggle id="toggle4" isOn="false" onValueChanged="toggleOption"></Toggle>
      </Cell>
    </Row>
    <Row id="row5" preferredHeight="50" active="false">
      <Cell>
        <Text id="text5">Option 5</Text>
        <Toggle id="toggle5" isOn="false" onValueChanged="toggleOption"></Toggle>
      </Cell>
    </Row>
    <Row id="row6" preferredHeight="50" active="false">
      <Cell>
        <Button id="submit" onClick="complexPurchase">
          Submit
        </Button>
      </Cell>
    </Row>
  </TableLayout>
</Panel>

<Panel offsetXY="0 0" id="finalScorePanel" visibility="hidden">
  <VerticalLayout id="score_layout" color="#FFFFFF" spacing="4" rectAlignment="middleCenter" Width="400" Height="300" allowDragging="true" returnToOriginalPositionWhenReleased="false" childForceExpandHeight="false" childControlHeight="false">
  <Panel Width="400" Height="50">
    <Text fontSize="32" color="#1A1A1A" fontStyle="Bold" alignment="MiddleCenter">
      Final Scores
    </Text>
  </Panel>
    <Panel id="player1panel" Width="400" Height="50" visiblity="hidden">
      <Text id="player1" fontSize="32" color="#1A1A1A" alignment="MiddleCenter">
        Placeholder Text
      </Text>
    </Panel>
    <Panel id="player2panel" Width="400" Height="50" visibility="hidden">
      <Text id="player2" fontSize="32" color="#1A1A1A" alignment="MiddleCenter">
        Placeholder Text
      </Text>
    </Panel>
    <Panel id="player3panel" Width="400" Height="50" visibility="hidden">
      <Text id="player3" fontSize="32" color="#1A1A1A" alignment="MiddleCenter">
        Placeholder Text
      </Text>
    </Panel>
    <Panel id="player4panel" Width="400" Height="50" visibility="hidden">
      <Text id="player4" fontSize="32" color="#1A1A1A" alignment="MiddleCenter">
        Placeholder Text
      </Text>
    </Panel>
    <Panel id="update_score_panel" Width="400" Height="50">
      <Button onClick="dismissScores" color="#FFFFFF" fontSize="24" shadow="#000000" outline="#000000">Dismiss</Button>
    </Panel>
  </VerticalLayout>
</Panel>