function onLoad()
  local buy_card = Global.getVar("buy_card")
  params = {
    click_function = "purchaseCard",
    function_owner = buy_card,
    position = {0, 1, 0},
    rotation = {0, 0, 0},
    width = 500,
    height = 500,
    color = {0.5, 0.5, 0.5, 0},
    tooltip = "Automatically build card.",
  }
  self.createButton(params)
end