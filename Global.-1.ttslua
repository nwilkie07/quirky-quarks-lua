--[[ The onLoad event is called after the game save finishes loading. --]]
-- setup variables used by many functions, call and change them here so we can change them only once
function onLoad()
  particles_zone = getObjectFromGUID("fd60b5")
  quest1_zone = getObjectFromGUID("d90940")
  quest2_zone = getObjectFromGUID("941bbf")

  particles_deck = particles_zone.getObjects()[1]
  quest1_deck = quest1_zone.getObjects()[1]
  quest2_deck = quest2_zone.getObjects()[1]

  particle_discard_zone = getObjectFromGUID("345485")
  quest1_discard_zone = getObjectFromGUID("a0c4a3")
  quest2_discard_zone = getObjectFromGUID("4af37c")

  collider_board = getObjectFromGUID("1f72b6")
  ejection_pile = getObjectFromGUID("9f4d22")

  one_ev_bag = getObjectFromGUID("d98962")
  three_ev_bag = getObjectFromGUID("66bc96")

  round_die = getObjectFromGUID("e19c46")
  phase_die = getObjectFromGUID("1050fc")

  buy_card = getObjectFromGUID("6425d0")
  turn_control = getObjectFromGUID("90061a")

  players = getPlayers()
end

function onPlayerChangeColor(player_color)
  players = getPlayers()
end

function getPlayers()
  local playerSet = {}
  if Player.Red.seated then
    table.insert(playerSet, "Red")
  end
  if Player.Green.seated then
    table.insert(playerSet, "Green")
  end
  if Player.Blue.seated then
    table.insert(playerSet, "Blue")
  end
  if Player.Yellow.seated then
    table.insert(playerSet, "Yellow")
  end
  return playerSet
end

--called when people bid on an object in the discovery phase
function onObjectCollisionEnter(object, collision_info)
  local collision_object = collision_info.collision_object

  -- Debounce: prevent multiple triggers from physics bounces
  -- local guid = object.getGUID()
  -- if collision_cooldown[guid] then return end
  --
  -- collision_cooldown[guid] = true
  -- Wait.time(function() collision_cooldown[guid] = nil end, COLLISION_COOLDOWN_TIME)

  -- player is not allowed to bid so return
  if object.getName() ~= turn_control.call("get_current_turn") then
    return
  end

  if current_phase == 4 and (collision_object.type == "Card" or collision_object.type == "Deck") and object.memo == "physicist" then
    ejection_pile.call("calculateBid", {["player_color"] = object.getName(), ["object"] = collision_object})
  end
end

function setOptions(cardType)
  table.insert(options, cardType)
end

function complexPurchase(player, value, id)
  buy_card.call("complexPurchase", {player, value, id})
end

-- loops through hands and check if players have neutrino cards
-- neutrino cards must be resolved immediately
local handleNeutrinoCalled = {
  ["Green"] = false,
  ["Blue"] = false,
  ["Red"] = false,
  ["Yellow"] = false
}

local neutrinoCheckScheduled = false
local neutrinosInProgress = 0

function contains(theTable, card)
  for i = 1, #theTable do
    if theTable[i].guid == card.guid then
      return true
    end
  end
  return false
end

function checkForNeutrinos()
  --goes through player hands to find neutrinos
  for i = 1, #players do
    local player_color = players[i]
    local hand_guid = color_hand_guid[player_color]
    local hand_objects = getObjectFromGUID(hand_guid).getObjects()

    --if this hand has not changed in number of cards then don't check for neutrinos
    for j = 1, #hand_objects do
      local card = hand_objects[j]
      --contains function prevents multiple triggers
      if card.getName() == "Neutrino"
      and contains(neutrinos_in_hand[player_color], card) == false
      and particle_discard_zone ~= nil
      and contains(particle_discard_zone.getObjects(), card) == false then
        table.insert(neutrinos_in_hand[player_color], card)
      end
    end
    -- call the function to give the player selection of the card
    if #neutrinos_in_hand[player_color] > 0 and handleNeutrinoCalled[player_color] == false then
      handleNeutrinoCalled[player_color] = true
      handleNeutrino(player_color)
    end
  end

  local current_neutrinos = 0
  for i = 1, #players do
    local thePlayer = players[i]
    if neutrinos_in_hand[thePlayer] ~= nil then
      current_neutrinos = current_neutrinos + #neutrinos_in_hand[thePlayer]
    end
  end
  --Ends Funding phase and Research (bidding) phase
  -- and current_phase + current_round == 2
  if current_neutrinos == 0 and neutrinosInProgress == 0 and neutrinosEndRound == true then
    endPhase()
    neutrinosEndRound = false
  end

end

-- places the neutrino in front of the player to make a choice (buttons on cards)
-- attaches button to cards to resolve (move cards around) after a player selects a card
function handleNeutrino(player_color)
  local neutrino_card = table.remove(neutrinos_in_hand[player_color])
  neutrinosInProgress = neutrinosInProgress + 1

  local build_board = getObjectFromGUID(build_board_guids[player_color])
  local pos = build_board.getPosition()
  local rot = build_board.getRotation()

  local x_mod = -2
  local y_height = pos["y"] + 1
  local z_mod = -6

  if rot["y"] == 180 then
    z_mod = 6
    x_mod = 2
  end

  neutrino_card.setPosition({pos["x"] - x_mod, y_height, pos["z"] + z_mod})
  neutrino_card.setRotation({rot["x"], rot["y"], 0})

  local particle1 = particles_deck.takeObject({
    position = {pos["x"], y_height, pos["z"] + z_mod},
    rotation = {rot["x"], rot["y"], 0},
    smooth = true,
    top = true,
  })
  particle1.createButton({
    click_function = "resolveNeutrino",
    label = "Choose this particle.",
    width = 400,
    height = 800,
    tooltip = "Select this card",
    color = {0, 0, 0, 0}
  })

  local particle2 = particles_deck.takeObject({
    position = {pos["x"] + x_mod, y_height, pos["z"] + z_mod},
    rotation = {rot["x"], rot["y"], 0},
    smooth = true,
    top = true,
  })
  particle2.createButton({
    click_function = "resolveNeutrino",
    label = "Choose this particle.",
    width = 400,
    height = 800,
    tooltip = "Select this card",
    color = {0, 0, 0, 0}
  })

  hideFromPlayers({particle1, particle2}, player_color)

  table.insert(selection_cards[player_color], particle1)
  table.insert(selection_cards[player_color], particle2)
  table.insert(selection_cards[player_color], neutrino_card)
end

--called on card selection to move selected card into the players hand
-- and the 2 other cards into the discard pile
function resolveNeutrino(click_obj, player_color)
  local cards = selection_cards[player_color]

  for i = 1, #cards do
    if cards[i].getButtons() ~= nil then
      cards[i].removeButton(0)
    end
    if cards[i].getGUID() ~= click_obj.getGUID() then
      Wait.condition(
        function()
          cards[i].setRotation(particle_discard_zone.getRotation())
          cards[i].setPositionSmooth(particle_discard_zone.getPosition())
        end,
        function()
          return cards[i] and cards[i].resting
        end,
        5,
        function()
          log("WARNING: Timeout waiting for neutrino discard card " .. i .. " to rest")
        end
      )
    else
      cards[i].deal(1, player_color)
    end
  end

  -- recursively works through other neutrinos a player hand
  -- is this not timing properly
  selection_cards[player_color] = {}
  neutrinosInProgress = neutrinosInProgress - 1

  Wait.condition(
    function()
      handleNeutrinoCalled[player_color] = false
      checkForNeutrinos()
    end,
    function() return click_obj == nil or click_obj.resting end,
    10,
    function()
      -- Timeout fallback: proceed anyway to avoid deadlock
      log("WARNING: Timeout waiting for neutrino resolution, proceeding anyway")
      handleNeutrinoCalled[resolved_color] = false
      checkForNeutrinos()
    end
  )
end

function getPlayerHandItems(color)
  local hand_items = {}
  local guid_items = {}
  local objects = Player[color].getHandObjects(1)
  if #objects > 0 then
    for i = 1, #objects do
      local object = objects[i]
      local name = object.getName()
      if hand_items[name] ~= nil then
        hand_items[name] = hand_items[name] + 1
      else
        hand_items[name] = 1
      end
      if guid_items[name] == nil then
        guid_items[name] = {object.guid}
      else
        table.insert(guid_items[name], object.guid)
      end
    end
  end
  return {hand_items, guid_items}
end

-- this functions records special cards that are placed in the build area for quests
-- so we can track and enact the abilities for the player
function addSpecialCard(player_color, object)
  if object == nil then
    return
  end

  local card_name = object.getName()
  if card_name == nil then
    return
  end

-- could add update gluonium tracker here


  if singleCardPowers[card_name] ~= nil then
    -- gain 9 eV immediately
    if card_name == "E Annihilation" then
      Wait.condition(
      function()
        one_ev_bag.call("dealCoins", {["value"] = 9, ["player_color"] = player_color})
      end,
      function()
        return object.resting
      end,
      5,
      function()
        broadcastToColor("Couldn't complete automatic E Annihilation code, please take 9eV Manually.", player_color)
      end
        )
      return
    end
  end

  for key, value in pairs(singleCardPowers) do
    if card_name == key and singleCardPowers[card_name] ~= nil then
      singleCardPowers[card_name] = player_color
      return
    end
  end

  if multiCardPowers[player_color][card_name] ~= nil then
    multiCardPowers[player_color][card_name] = multiCardPowers[player_color][card_name] + 1
  end
end

--function to remove special card if player accidentally placed a card
--in their build area, then remove it
function removeSpecialCard(player_color, object)
  if object == nil then
    return
  end

  local card_name = object.getName()
  if card_name == nil then
    return
  end

  if singleCardPowers[card_name] ~= nil then
    -- gain 9 eV immediately
    if card_name == "E Annihilation" then
      --could call spendMoney function here to retract the mistaken income
      if one_ev_bag then
        on_ev_bag.call("spendCoins", {["cost"] = 9, ["player_color"] = player_color})
      end
      broadcastToColor("9 eV deducted: E Annihilation removed from your build area.", player_color)
      return
    end
  end

  for key, value in pairs(singleCardPowers) do
    if card_name == key and singleCardPowers[card_name] ~= nil then
      singleCardPowers[card_name] = "none"
      return
    end
  end

  if multiCardPowers[player_color][card_name] ~= nil then
    multiCardPowers[player_color][card_name] = multiCardPowers[player_color][card_name] - 1
    if multiCardPowers[player_color][card_name] < 0 then
      multiCardPowers[player_color][card_name] = 0
    end
  end
end

--attempt to preform arithmetic on a nil value when card enters hand
function countTableValues(theTable)
  log(theTable);
  local count = 0
  for i = 1, #players do
    if theTable[players[i]] ~= nil then
      count = count + theTable[players[i]]
    end
  end
  log("Card Tracking count")
  log(count)
  return count
end

-- used to track turns during quest
local quest_turn_count = 0

--loops through and checks if draws are compelete in Phase 1
function drawsComplete()
  local count = countTableValues(player_draws)

  --if everyone has drawn end funding phase
  if count <= 0 then
    colliders_complete = false -- controls onObjectEnter draw tracking function
    quest_turn_count = 0

    -- fully reset the table
    for i = 1, #players do
      player_draws[players[i]] = 0
    end

    onRoundChange()
  end
end

-- does not work because dealing out colliders causes this to trigger
function onObjectEnterZone(zone, enter_object)
  if enter_object ~= nil and zone ~= nil then
    --add checks to prevent quest triggers during other phases and during drawing
    if zone.type == "Layout" and enter_object.type == "Card" and current_phase == PHASE_QUEST then
      -- look through player completed quest cards and record gluonium card_cost
      local name = zone.getName()
      local color = string.sub(name, 1, #name - 5)
        updateGluoniumTracker({["color"] = color, ["zone"] = zone})
      -- potentially add debounced score here.
    end

    -- monitors draws to know when to end the phase during round 2-5 phase 1 (Funding)
    -- requires Quest phase but all quests turns be completed so players are drawing

    --ERROR Here in quest phase arithmetic nil value
    if current_phase == PHASE_QUEST and quest_turn_count >= #players then
      -- check if all cards have been drawn and end phase
      if enter_object.getName() ~= "Neutrino" and zone ~= nil and player_draws[zone.getName()] ~= nil then
        player_draws[zone.getName()] = player_draws[zone.getName()] - 1

        -- to prevent weird behavior with drawsComplete calculating
        if player_draws[zone.getName()] < 0 then
          player_draws[zone.getName()] = 0
        end
      end
      drawsComplete()
    end

    if current_phase ~= PHASE_FUNDING and enter_object.getName() == "Neutrino" then
      -- called as neutrinos must be dealt with immediately
      -- debounce: only schedule one check at a time
      if not neutrinoCheckScheduled then
        neutrinoCheckScheduled = true
        Wait.condition(function()
          neutrinoCheckScheduled = false
          checkForNeutrinos()
        end,
        function()
          return enter_object == nil or enter_object.resting
        end,
        10,
        function()
          -- Timeout fallback: proceed to avoid blocking the game
          log("WARNING: Timeout waiting for neutrino card to rest, proceeding anyway")
          neutrinoCheckScheduled = false
          checkForNeutrinos()
        end)
      end
    end
  end
end

function onObjectLeaveZone(zone, object)
  if zone.type == "Layout" and object.type == "Card" and object.memo ~= "particle" then
    updateScore({["zone"] = zone, ["object"] = object, ["state"] = "exit"})
  end

  if zone.type == "Scripting" and object.type == "Tile" and (object.memo == "three" or object.memo == "one") and zone.memo == "Coin" then
    updateCoins(zone)
  end
end

function updateCoins(zone)
  local name = zone.getName()
  local color = string.sub(name, 1, #name - 5)
  local coin_board = getObjectFromGUID(coin_board_guids[color])
  local value = three_ev_bag.call("calculateCoins", color)
  if coin_board ~= nil and value ~= nil then
    coin_board.call("updateCoinText", value)
  end
end

function updateScore(data)
  local zone = data["zone"]
  local object = data["object"]
  local state = data["state"]

  if object == nil or zone == nil then
    return
  end

  local name = zone.getName()
  local score = 0

  -- updating score when items are placed in zone
  local area_name = string.sub(name, #name - 3)
  local color = string.sub(name, 1, #name - 5)
  local build_board = getObjectFromGUID(build_board_guids[color])

  -- update both anytime there are changes
  score = three_ev_bag.call("calculateScore", color)
  build_board.call("updateScoreText", score)
  updateCoins(zone)

  if area_name == "Zone" then
    --the event trigger enter collision or exit collision
    if state == "enter" then
      addSpecialCard(color, object)
    end
    if state == "exit" then
      removeSpecialCard(color, object)
    end

  end
end

function updateGluoniumTracker(data)
  local player_color = data["color"]
  local zone = data["zone"]
  --goes through player build zones to find build Gluonium cards
  local quest_cards = zone.getObjects()
  -- looks through player cards to see if player has gluonium
  local count = 0
  for i = 1, #quest_cards do
    if quest_cards[i].getName() == "Gluonium" then
      count = count + 1
    end
  end
  -- this keeps tack of gluonium cards in hand but can't be used
  -- for tracking how the cards being spent in a round
  gluonium_tracker[player_color] = count
end

function resetGluoniumTracking()
  for color, _ in pairs(spent_gluonium) do
    spent_gluonium[color] = 0
    gluonium_tracker[color] = 0
  end
end

function updateScoreUi(player)
  local color = player.color
  local coin_board = getObjectFromGUID(coin_board_guids[color])
  local value = three_ev_bag.call("calculateCoins", color)
  local build_board = getObjectFromGUID(build_board_guids[color])
  score = three_ev_bag.call("calculateScore", color)
  coin_board.call("updateCoinText", value)
  build_board.call("updateScoreText", score)
end

function toggleOption(player, value, id)
  UI.setAttribute(id, "isOn", value)
end

function toggleUiTools()
  local state = UI.getAttribute("sort_cards", "visibility")
  if state == "hidden" then
    UI.setAttribute("sort_cards", "visibility", "")
    UI.setAttribute("sort_coins", "visibility", "")
    UI.setAttribute("update_score", "visibility", "")
  else
    UI.setAttribute("sort_cards", "visibility", "hidden")
    UI.setAttribute("sort_coins", "visibility", "hidden")
    UI.setAttribute("update_score", "visibility", "hidden")
  end
end

function sort_hand(player)
  local hand = getObjectFromGUID(color_hand_guid[player.color])
  local cards = hand.getObjects()
  local org_pos = {}

  for i = 1, #cards do
    table.insert(org_pos, cards[i].getPosition())
  end

  -- quick sort to sort cards by type
  cards = ejection_pile.call("expandToSort", {cards, 1, #cards, "name"})
  -- quick sort cards by pile type (quest1, quest2, particles)
  cards = ejection_pile.call("expandToSort", {cards, 1, #cards, "memo"})

  for i = 1, #cards do
    cards[i].setPosition(org_pos[i])
  end
end

function layout_coins(player)
  local one_bag = getObjectFromGUID("d98962")
  one_bag.call("layoutCoins", player.color)
end

--2n runtime
-- checking if the object is being held by a player
function isHeldByPlayer(object)
  local held_objects = {}
  local green_obj = Player.Green.getHoldingObjects()
  local red_obj = Player.Red.getHoldingObjects()
  local blue_obj = Player.Blue.getHoldingObjects()
  local yellow_obj = Player.Yellow.getHoldingObjects()

  if green_obj ~= nil then
    spreadAndInsert(green_obj, held_objects)
  end

  if red_obj ~= nil then
    spreadAndInsert(red_obj, held_objects)
  end

  if blue_obj ~= nil then
    spreadAndInsert(blue_obj, held_objects)
  end

  if yellow_obj ~= nil then
    spreadAndInsert(yellow_obj, held_objects)
  end

  if held_objects ~= nil and object ~= nil then
    for i = 1, #held_objects do
      if held_objects[i].getGUID() == object.getGUID() then
        return true
      end
    end
  end

  return false
end

function spreadAndInsert(values, insertTable)
  for i = 1, #values do
    table.insert(insertTable, values[i])
  end
end

function endPhase()
  if current_phase == 5 then
    current_phase = 1
  else
    current_phase = current_phase + 1
  end
  onPhaseChange()
end

function trackQuestPhase()
  quest_turn_count = quest_turn_count + 1
  if quest_turn_count >= #players then
    -- Reset gluonium tracking when quest phase ends (before moving to funding phase)
    if current_round == 5 then
      onRoundChange()
      return
    end
    setupDrawTracking()
  else
    turn_control.call("next_turn")
  end
end

function onPhaseChange()
  phase_die.setRotationSmooth(dice_rot[current_phase])
  phase_die.setPositionSmooth(phase_dice_pos[current_phase])

  if current_phase == 1 then
    --deal out colliders now that draws are done and end funding phase
    local starting_card = getObjectFromGUID("de36d4")
    starting_card.setPositionSmooth(starting_card_positions[starting_physicist])
    neutrinosEndRound = true
    neutrinosInProgress = 0
    for i = 1, #players do
      neutrinos_in_hand[players[i]] = {}
    end
    if #players >= 3 then
      collider_board.call("four_player_deal")
    else
      collider_board.call("two_player_deal")
    end
  elseif current_phase == 2 then
    --Research Phase, show bid buttons
    collider_board.UI.setAttribute("slac_panel", "visibility", "")
    collider_board.UI.setAttribute("tevatron_panel", "visibility", "")
    collider_board.UI.setAttribute("esrf_panel", "visibility", "")
    collider_board.UI.setAttribute("lhc_panel", "visibility", "")
    Global.UI.setAttribute("change_turn", "onClick", "1f72b6/onEndTurn")

    if #players == 4 then
      collider_board.UI.setAttribute("kekb_panel", "visibility", "")
    end

    broadcastToAll("Research phase starts. " ..starting_physicist.. " bids first.")

  elseif current_phase == 3 then
    --Ejection Phase send message to each player on discard amount
    collider_board.UI.setAttribute("slac_panel", "visibility", "hidden")
    collider_board.UI.setAttribute("tevatron_panel", "visibility", "hidden")
    collider_board.UI.setAttribute("esrf_panel", "visibility", "hidden")
    collider_board.UI.setAttribute("lhc_panel", "visibility", "hidden")
    collider_board.UI.setAttribute("kekb_panel", "visibility", "hidden")
    Global.UI.setAttribute("change_turn", "onClick", "27af07/setEjectionsToZero")
    --do something here to deal with beforeEject cards

    particles_deck.call("onEjectionPhaseStart")
  elseif current_phase == 4 then
    if singleCardPowers["Pion After Eject"] ~= "none" then
      broadcastToColor("You get to draw " ..math.floor(current_round / 2).. " extra cards of your choice due to your completed Pion.", singleCardPowers["Pion After Eject"])
    end

    --Discovery Phase
    collider_board.UI.setAttribute("discovery_panel", "visibility", "")
    ejection_pile.call("setupDiscoveryPhase")
    Global.UI.setAttribute("change_turn", "onClick", "9f4d22/onEndTurn")

  elseif current_phase == 5 then
    --Quest Phase
    Global.UI.setAttribute("change_turn", "onClick", "trackQuestPhase")
    collider_board.UI.setAttribute("discovery_panel", "visibility", "hidden")
    broadcastToAll("Quest phase starts. " ..starting_physicist.. " completes their quests first.")
  end
  turn_control.call("set_turn", starting_physicist)
  collider_board.UI.setAttribute("round_tracker", "text", "Round " ..current_round.. ": " .. phase_text[current_phase] .. " Phase")
end

function onRoundChange()

  -- decide next player
  -- obtuse logic to prevent spamming change turn button problems
  local num_order = turn_control.getTable("num_order")
  local order_num = turn_control.getTable("order_num")
  local oldPlayerNum = order_num[starting_physicist]
  if oldPlayerNum >= #players then
    starting_physicist = num_order[1]
  else
    starting_physicist = num_order[oldPlayerNum + 1]
  end
  turn_control.call("set_turn", starting_physicist)

  --reset spent_gluonium and gluonium_tracker
  -- Reset directly in Global
  for color, _ in pairs(spent_gluonium) do
    spent_gluonium[color] = 0
    gluonium_tracker[color] = 0
  end

  -- recalculate gluonium counts for each player
  for i = 1, #players do
    local color = players[i]
    local zone_guid = build_zone_guids[color]
    local zone = getObjectFromGUID(zone_guid)
    if zone then
      updateGluoniumTracker({["color"] = color, ["zone"] = zone})
    end
  end

  resetGluoniumTracking()

  if current_round >= 5 then
    broadcastToAll("You've reached the end of the game!", Table)
    showScorePanel()
  else
    current_round = current_round + 1
    round_die.setRotationSmooth(dice_rot[current_round])
    round_die.setPositionSmooth(round_dice_pos[current_round])
    endPhase()
  end
end

function setupDrawTracking()
  --reset turn control
  Global.UI.setAttribute("change_turn", "onClick", "90061a/next_turn")

  --fully reset and setup player draw tracking
  player_draws = {}
  for i = 1, #players do
    player_draws[players[i]] = 1
  end

  -- check for and update player draw_counts if they have these special cards
  -- we add an additional round as we handle drawing before the new round begins
  if singleCardPowers["Green Pion Start"] ~= "none" then
    local color = singleCardPowers["Green Pion Start"]
    player_draws[color] = player_draws[color] + math.floor((current_round + 1) / 2)
  end
  -- two if statements in case the player has both cards
  if singleCardPowers["Blue Pion Start"] ~= "none" then
    local color = singleCardPowers["Blue Pion Start"]
    player_draws[color] = player_draws[color] + math.floor((current_round + 1) / 2)
  end

  --loop to deal money to each player and tell them how many cards to draw
  for i = 1, #players do
    local player_color = players[i]

    --players get 3 eV each round or more if they have Up Annhilation
    if singleCardPowers["Up Annihilation"] == player_color then
      --current_round is always one behind as we do this behavior before round turns over
      one_ev_bag.call("dealCoins", {["value"] = 3 + (current_round + 1), ["player_color"] = player_color})
    else
      one_ev_bag.call("dealCoins", {["value"] = 3, ["player_color"] = player_color})
    end

    broadcastToColor("Draw " ..player_draws[player_color].. " card(s).", player_color)
  end
end

--sets a table of objects to hidden from all but the provided player
function hideFromPlayers(objects, player_color)
  local hide_players = getPlayers()
  for i = 1, #hide_players do
    if hide_players[i] == player_color then
      table.remove(hide_players, i)
      break
    end
  end
  for j = 1, #objects do
    objects[j].setHiddenFrom(hide_players)
  end
end


function showScorePanel()
  local players = getPlayers();
  local scores = {}
  for i = 1, #players do
    local point_value = three_ev_bag.call("calculateScore", players[i])
    table.insert(scores, {["color"] = players[i], ["score"] = point_value})
  end

  table.sort(scores, function(a, b) return a.score > b.score end)

  for i, value in ipairs(scores) do
    UI.setAttribute("player" .. i, "text", value["color"] .. " players score: " .. value["score"])
    UI.setAttribute("player" .. i .. "panel", "visibility", "")
  end

  UI.setAttribute("score_layout", "Height", (#players * 50) + (100))
  UI.setAttribute("finalScorePanel", "visibility", "") -- set panel visible
end

function dismissScores()
  UI.setAttribute("finalScorePanel", "visibility", "hidden")
end