function onLoad()
  params = {
    click_function = "endPhase",
    function_owner = self,
    position = {0, 1, 0},
    rotation = {0, 180, 0},
    width = 1500,
    height = 1200,
    color = {0.5, 0.5, 0.5, 0},
    tooltip = "Go to the next phase.",
  }
  self.createButton(params)
end

function endPhase()
  Global.call("checkForNeutrinos")
end